const MC_Utils={require(v,m){if(v===undefined||v===null||v==='')throw new Error(m);return v},num(v){const n=Number(v);this.require(Number.isFinite(n),'Nominal tidak valid');return n},sha256(v){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')},nextId(p){return p+'-'+Utilities.getUuid().slice(0,8).toUpperCase()},nextCif(category){const cat=String(category||'').toUpperCase();const prefix=(cat==='CORPORATE'||cat==='PERUSAHAAN'||cat==='CORP')?'P':'AMR';const key='SEQ_CIF_'+prefix;const l=LockService.getScriptLock();l.waitLock(30000);try{const q=PropertiesService.getScriptProperties(),n=Number(q.getProperty(key)||0)+1;q.setProperty(key,String(n));return prefix+'-'+String(n).padStart(4,'0')}finally{l.releaseLock()}},nextInvoice(){const l=LockService.getScriptLock();l.waitLock(30000);try{const k='SEQ_'+Utilities.formatDate(new Date(),MC_CONFIG.TIMEZONE,'yyyyMMdd'),p='INV-'+Utilities.formatDate(new Date(),MC_CONFIG.TIMEZONE,'yyyyMMdd')+'-',q=PropertiesService.getScriptProperties(),n=Number(q.getProperty(k)||0)+1;q.setProperty(k,String(n));return p+String(n).padStart(5,'0')}finally{l.releaseLock()}}};