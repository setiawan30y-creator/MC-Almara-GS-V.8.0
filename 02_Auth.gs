const MC_Auth={login(p){MC_Utils.require(p&&p.username&&p.password,'Username dan password wajib diisi');const u=MC_Database.find('USERS','USERNAME',String(p.username).trim());MC_Utils.require(u&&u.STATUS==='ACTIVE','Login gagal');MC_Utils.require(MC_Utils.sha256(p.password)===u.PASSWORD_HASH,'Login gagal');const token=Utilities.getUuid(),data={userId:u.ID,name:u.NAME,roleId:u.ROLE_ID,createdAt:Date.now()};CacheService.getScriptCache().put('SESSION_'+token,JSON.stringify(data),MC_CONFIG.SESSION_TTL);return{token,user:{id:u.ID,name:u.NAME,roleId:u.ROLE_ID}}},session(t){if(!t)return null;const v=CacheService.getScriptCache().get('SESSION_'+t);return v?JSON.parse(v):null},logout(t){if(t)CacheService.getScriptCache().remove('SESSION_'+t);return{ok:true}},can(s,m,p){MC_Utils.require(s&&s.roleId,'Session tidak valid');if(s.roleId==='ROLE-1')return true;return MC_Database.rows('PERMISSIONS').some(x=>x.ROLE_ID===s.roleId&&x.MODULE===m&&x.PERMISSION===p&&x.STATUS==='ACTIVE')},requirePermission(s,m,p){MC_Utils.require(this.can(s,m,p),'Permission ditolak: '+p+' / '+m);return true},createInitialAdmin(){if(MC_Database.rows('USERS').some(x=>x.ROLE_ID==='ROLE-1'))return{ok:true,exists:true};const u={ID:MC_Utils.nextId('USR'),USERNAME:'admin',EMAIL:'',PASSWORD_HASH:MC_Utils.sha256('admin123'),NAME:'Administrator',ROLE_ID:'ROLE-1',STATUS:'ACTIVE',CREATED_AT:new Date(),UPDATED_AT:new Date()};MC_Database.insert('USERS',u);MC_Database.audit('Auth','CREATE',u.ID,null,u,'Initial admin');return{ok:true,username:'admin',temporaryPassword:'admin123'}}};