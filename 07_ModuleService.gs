owerCase();if(query)rows=rows.filter(function(r){return Object.keys(r).some(function(k){return String(r[k]==null?'':r[k]).toLowerCase().indexOf(query)>=0})});var page=Math.max(1,Number(q&&q.page||1));var pageSize=Math.min(100,Math.max(10,Number(q&&q.pageSize||25)));var pageRows=rows.slice((page-1)*pageSize,(page-1)*pageSize+pageSize).map(function(r){var o={};Object.keys(r).forEach(function(k){var v=r[k];o[k]=v instanceof Date?v.toISOString():v});return o});return{rows:pageRows,total:rows.length,page:page,pageSize:pageSize}},get:function(module,id){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak memiliki data sheet');return MC_Database.rows(m.sheet).find(function(r){return String(r.ID)===String(id)})||null},validate:function(module,record){var m=this.meta(module);(m.form||[]).forEach(function(f){if(f[3]&&(record[f[0]]===undefined||record[f[0]]===null||record[f[0]]===''))throw new Error(f[1]+' wajib diisi')});return record},create:function(module,record){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak mendukung create');if(['financial','transaction','rate'].indexOf(m.mode)>=0)throw new Error('Perubahan finansial harus melalui Core Engine/action module');this.validate(module,record);var id=MC_Utils.nextId(MC_ID_PREFIX[module]||module.slice(0,3).toUpperCase());var x=Object.assign({},record,{ID:id,CREATED_AT:new Date()});MC_Database.insert(m.sheet,x);MC_Database.audit(module,'CREATE',id,null,x,'API module.create');return x},update:function(module,id,record){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak mendukung update');if(['financial','transaction','rate'].indexOf(m.mode)>=0)throw new Error('Perubahan finansial harus melalui Core Engine/action module');var current=this.get(module,id);if(!current)throw new Error('Record tidak ditemukan');this.validate(module,Object.assign({},current,record));var next=Object.assign({},current,record,{ID:id,UPDATED_AT:new Date()});MC_Database.update(m.sheet,'ID',id,next);MC_Database.