const MC_ModuleService={meta:function(module){if(!MC_MODULES[module])throw new Error('Module tidak terdaftar: '+module);return MC_MODULES[module]},schema:function(module){var m=this.meta(module);return{module:module,title:m.title,sheet:m.sheet,mode:m.mode,columns:m.columns,form:m.form,capabilities:this.capabilities(m)}},capabilities:function(m){if(['dashboard','public','report','utility','profile'].indexOf(m.mode)>=0)return{view:true,create:false,edit:false,delete:false};if(['financial','transaction','rate','admin','settings'].indexOf(m.mode)>=0)return{view:true,create:true,edit:true,delete:false};return{view:true,create:true,edit:true,delete:true}},list:function(module,q){var m=this.meta(module);if(!m.sheet)return{rows:[],total:0,page:1,pageSize:25};var rows=MC_Database.rows(m.sheet);var query=String(q&&q.search||'').trim().toLowerCase();if(query)rows=rows.filter(function(r){return Object.keys(r).some(function(k){return String(r[k]==null?'':r[k]).toLowerCase().indexOf(query)>=0})});var page=Math.max(1,Number(q&&q.page||1));var pageSize=Math.min(100,Math.max(10,Number(q&&q.pageSize||25)));return{rows:rows.slice((page-1)*pageSize,(page-1)*pageSize+pageSize),total:rows.length,page:page,pageSize:pageSize}},get:function(module,id){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak memiliki data sheet');return MC_Database.rows(m.sheet).find(function(r){return String(r.ID)===String(id)})||null},create:function(module,record){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak mendukung create');if(['financial','transaction','rate'].indexOf(m.mode)>=0)throw new Error('Perubahan finansial harus melalui Core Engine/action module');var id=MC_Utils.nextId(module.slice(0,3).toUpperCase());var x=Object.assign({},record,{ID:id,CREATED_AT:new Date()});MC_Database.insert(m.sheet,x);MC_Database.audit(module,'CREATE',id,null,x,'API module.create');return x},update:function(module,id,record){var m=this.meta(module);if(!m.sheet)throw new Error('Module tidak mendukung update');if(['financial','transaction','rate'].indexOf(m.mode)>=0)throw new Error('Perubahan finansial harus melalui Core Engine/action module');var current=this.get(module,id);if(!current)throw new Error('Record tidak ditemukan');var next=Object.assign({},current,record,{ID:id,UPDATED_AT:new Date()});MC_Database.update(m.sheet,'ID',id,next);MC_Database.audit(module,'UPDATE',id,current,next,'API module.update');return next},remove:function(){throw new Error('Delete contract tersedia tetapi ditahan sampai policy delete ditetapkan')},action:function(module,action,id){return{module:module,action:action,id:id||null,status:'CONTRACT_ONLY',message:'Action contract tersedia; business rule akan dihubungkan ke engine module.'}}};
const MC_API_CONTRACT={version:'1.0',envelope:{ok:'boolean',data:'any',error:'string|null',meta:'object'},endpoints:{'auth.login':{method:'login',permission:'public',payload:['username','password'],returns:'session'},'auth.logout':{method:'logout',permission:'session',payload:['token'],returns:'boolean'},'module.schema':{method:'moduleSchema',permission:'view',payload:['module'],returns:'module metadata'},'module.list':{method:'moduleList',permission:'view',payload:['module','query?'],returns:'{rows,total,page,pageSize}'},'module.get':{method:'moduleGet',permission:'view',payload:['module','id'],returns:'record'},'module.create':{method:'moduleCreate',permission:'create',payload:['module','record'],returns:'record'},'module.update':{method:'moduleUpdate',permission:'edit',payload:['module','id','record','reason?'],returns:'record'},'module.delete':{method:'moduleDelete',permission:'delete',payload:['module','id','reason?'],returns:'boolean'},'module.action':{method:'moduleAction',permission:'module-specific',payload:['module','action','id?','data?'],returns:'action result'},'dashboard.summary':{method:'dashboard',permission:'view',payload:['dateFrom?','dateTo?','branchId?'],returns:'dashboard summary'},'transaction.post':{method:'createTransaction',permission:'create',payload:['customerId','side','purpose','fundSource','items','payments'],returns:'transaction result'},'transaction.preview':{method:'transactionPreview',permission:'view',payload:['id'],returns:'transaction preview'},'transaction.edit':{method:'transactionEdit',permission:'transaction_edit',payload:['id','changes','reason'],returns:'transaction result'},'report.run':{method:'reportRun',permission:'view',payload:['report','filters','format'],returns:'report result'},'public.rates':{method:'publicRates',permission:'public',payload:[],returns:'rate rows'}}};