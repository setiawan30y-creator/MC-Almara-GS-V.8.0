const MC_Core={transaction:function(p,s){var lock=LockService.getScriptLock();lock.waitLock(30000);try{MC_Utils.require(p&&['BUY','SELL'].includes(p.side),'Side transaksi tidak valid');MC_Utils.require(Array.isArray(p.items)&&p.items.length,'Item transaksi wajib diisi');var items=p.items.map(function(i){var foreign=MC_Utils.num(i.foreignAmount),rate=MC_Utils.num(i.rate);MC_Utils.require(foreign>0,'Foreign amount harus lebih dari 0');MC_Utils.require(rate>0,'Rate harus lebih dari 0');return{currency:String(i.currency||''),denomination:i.denomination||'',type:i.type||'NOTE',foreignAmount:foreign,rate:rate,idrTotal:foreign*rate}});var total=items.reduce(function(a,i){return a+i.idrTotal},0);var payments=(p.payments||[]).map(function(x){var amount=MC_Utils.num(x.amount);MC_Utils.require(amount>0,'Nominal pembayaran harus lebih dari 0');MC_Utils.require(['CASH','BANK'].includes(x.method),'Metode pembayaran tidak valid');return{method:x.method,amount:amount,bankAccountId:x.bankAccountId||'',reference:x.reference||''}});var paid=payments.reduce(function(a,x){return a+x.amount},0);MC_Utils.require(Math.abs(paid-total)<0.01,'Pembayaran tidak sama dengan total');payments.filter(function(x){return x.method==='BANK'}).forEach(function(x){MC_Utils.require(x.bankAccountId,'Rekening bank wajib untuk pembayaran transfer');var bank=MC_Database.find('BANK_ACCOUNTS','ID',x.bankAccountId);MC_Utils.require(bank&&bank.STATUS==='ACTIVE','Rekening bank tidak aktif atau tidak ditemukan')});var id=MC_Utils.nextId('TRX'),invoice=MC_Utils.nextInvoice(),now=new Date(),tx={ID:id,INVOICE_NO:invoice,CUSTOMER_ID:p.customerId||'',BRANCH_ID:p.branchId||'',TELLER_ID:s.userId,DATE:now,SIDE:p.side,PURPOSE:p.purpose||'',FUND_SOURCE:p.fundSource||'',STATUS:'POSTED',CREATED_AT:now,UPDATED_AT:now};MC_Database.insert('TRANSACTIONS',tx);items.forEach(function(i){MC_Database.insert('TRANSACTION_ITEMS',{ID:MC_Utils.nextId('TRI'),TRANSACTION_ID:id,CURRENCY:i.currency,DENOMINATION:i.denomination,SIDE:p.side,FOREIGN_AMOUNT:i.foreignAmount,RATE:i.rate,IDR_TOTAL:i.idrTotal,CREATED_AT:now});MC_Database.insert('FX_STOCK_MUTATIONS',{ID:MC_Utils.nextId('FSM'),DATE:now,REF_TYPE:'TRANSACTION',REF_ID:id,CURRENCY:i.currency,DENOMINATION:i.denomination,TYPE:i.type,QTY_DELTA:p.side==='BUY'?i.foreignAmount:-i.foreignAmount,RATE:i.rate,USER_ID:s.userId,CREATED_AT:now})});payments.forEach(function(x){MC_Database.insert('TRANSACTION_PAYMENTS',{ID:MC_Utils.nextId('PAY'),TRANSACTION_ID:id,METHOD:x.method,AMOUNT:x.amount,BANK_ACCOUNT_ID:x.bankAccountId,REFERENCE:x.reference,CREATED_AT:now});var direction=p.side==='BUY'?'OUT':'IN';if(x.method==='CASH')MC_Database.insert('CASH_MUTATIONS',{ID:MC_Utils.nextId('CM'),DATE:now,REF_TYPE:'TRANSACTION',REF_ID:id,DIRECTION:direction,AMOUNT:x.amount,DENOMINATION:'',QTY:'',DESCRIPTION:invoice,BALANCE_AFTER:'',USER_ID:s.userId,CREATED_AT:now});if(x.method==='BANK'){var bank=MC_Database.find('BANK_ACCOUNTS','ID',x.bankAccountId),signed=p.side==='BUY'?-x.amount:x.amount,after=Number(bank.CURRENT_BALANCE||0)+signed;MC_Database.insert('BANK_MUTATIONS',{ID:MC_Utils.nextId('BM'),DATE:now,BANK_ACCOUNT_ID:x.bankAccountId,REF_TYPE:'TRANSACTION',REF_ID:id,DIRECTION:direction,AMOUNT:x.amount,BALANCE_AFTER:after,DESCRIPTION:invoice,USER_ID:s.userId,CREATED_AT:now});MC_Database.update('BANK_ACCOUNTS','ID',x.bankAccountId,Object.assign({},bank,{CURRENT_BALANCE:after,UPDATED_AT:now}))}});MC_Database.audit('Transaksi','CREATE',id,null,tx,'Core Engine');return{ok:true,id:id,invoice:invoice,total:total,payments:payments.length}}finally{lock.releaseLock()}}};