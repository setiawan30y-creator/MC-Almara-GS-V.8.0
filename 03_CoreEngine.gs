const MC_Core={transaction(p,s){MC_Utils.require(p&&['BUY','SELL'].includes(p.side),'Side transaksi tidak valid');MC_Utils.require(Array.isArray(p.items)&&p.items.length,'Item transaksi wajib diisi');const id=MC_Utils.nextId('TRX'),invoice=MC_Utils.nextInvoice(),tx={ID:id,INVOICE_NO:invoice,CUSTOMER_ID:p.customerId||'',BRANCH_ID:p.branchId||'',TELLER_ID:s.userId,DATE:new Date(),SIDE:p.side,PURPOSE:p.purpose||'',FUND_SOURCE:p.fundSource||'',STATUS:'POSTED',CREATED_AT:new Date(),UPDATED_AT:new Date()};MC_Database.insert('TRANSACTIONS',tx);let total=0;p.items.forEach(i=>{const foreign=MC_Utils.num(i.foreignAmount),rate=MC_Utils.num(i.rate),idr=foreign*rate;total+=idr;MC_Database.insert('TRANSACTION_ITEMS',{ID:MC_Utils.nextId('TRI'),TRANSACTION_ID:id,CURRENCY:i.currency,DENOMINATION:i.denomination||'',SIDE:p.side,FOREIGN_AMOUNT:foreign,RATE:rate,IDR_TOTAL:idr,CREATED_AT:new Date()});MC_Database.insert('FX_STOCK_MUTATIONS',{ID:MC_Utils.nextId('FSM'),DATE:new Date(),REF_TYPE:'TRANSACTION',REF_ID:id,CURRENCY:i.currency,DENOMINATION:i.denomination||'',TYPE:'NOTE',QTY_DELTA:p.side==='BUY'?foreign:-foreign,RATE:rate,USER_ID:s.userId,CREATED_AT:new Date()})});const paid=(p.payments||[]).reduce((a,x)=>a+MC_Utils.num(x.amount),0);MC_Utils.require(Math.abs(paid-total)<.01,'Pembayaran tidak sama dengan total');(p.payments||[]).forEach(x=>{MC_Database.insert('TRANSACTION_PAYMENTS',{ID:MC_Utils.nextId('PAY'),TRANSACTION_ID:id,METHOD:x.method,AMOUNT:MC_Utils.num(x.amount),BANK_ACCOUNT_ID:x.bankAccountId||'',REFERENCE:x.reference||'',CREATED_AT:new Date()});if(x.method==='CASH')MC_Database.insert('CASH_MUTATIONS',{ID:MC_Utils.nextId('CM'),DATE:new Date(),REF_TYPE:'TRANSACTION',REF_ID:id,DIRECTION:p.side==='BUY'?'OUT':'IN',AMOUNT:MC_Utils.num(x.amount),DENOMINATION:'',QTY:'',DESCRIPTION:invoice,BALANCE_AFTER:'',USER_ID:s.userId,CREATED_AT:new Date()})});MC_Database.audit('Transaksi','CREATE',id,null,tx,'Core Engine');return{ok:true,id,invoice,total}}};