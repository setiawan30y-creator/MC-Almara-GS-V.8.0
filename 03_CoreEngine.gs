_closingCashSystem:function(branchId,asOf){
  var d=asOf?new Date(asOf):new Date(),sum=0;
  MC_Database.rows('CASH_OPENING').forEach(function(x){
    var ed=new Date(x.EFFECTIVE_DATE||x.DATE);
    if(String(x.STATUS||'ACTIVE').toUpperCase()==='ACTIVE'&&ed<=d&&(!branchId||String(x.BRANCH_ID||'')===String(branchId)))sum+=Number(x.AMOUNT||0);
  });
  MC_Database.rows('CASH_MUTATIONS').forEach(function(x){
    var md=new Date(x.DATE||x.CREATED_AT);
    if(md<=d){
      var a=Number(x.AMOUNT||0);
      sum+=String(x.DIRECTION||'').toUpperCase()==='IN'?a:-a;
    }
  });
  return sum;
},
_closingGantungan:function(asOf){
  var d=asOf?new Date(asOf):new Date(),sum=0;
  MC_Database.rows('GANTUNGAN').forEach(function(x){
    var cd=new Date(x.DATE||x.CREATED_AT),rd=x.RETURN_DATE?new Date(x.RETURN_DATE):null,status=String(x.STATUS||'OUTSTANDING').toUpperCase();
