const MC_Router={render(e){return HtmlService.createTemplateFromFile('Index').evaluate().setTitle(MC_CONFIG.APP_NAME).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)},api(a,p){if(a==='login')return MC_Auth.login(p);if(a==='publicRates')return MC_Database.rows('RATE_MASTER').filter(x=>x.STATUS==='ACTIVE');const s=MC_Auth.session(p.token);MC_Utils.require(s,'Session tidak valid');if(a==='logout')return MC_Auth.logout(p.token);if(a==='dashboard')return{purchase:0,sale:0,cash:0,bank:MC_Database.rows('BANK_ACCOUNTS').reduce((n,x)=>n+Number(x.CURRENT_BALANCE||0),0)};if(a==='currencies')return MC_Database.rows('CURRENCY_MASTER');if(a==='customers')return MC_Database.rows('CUSTOMERS');if(a==='transactions')return MC_Database.rows('TRANSACTIONS');if(a==='saveCustomer'){const id=MC_Utils.nextId('NAS'),x={ID:id,IDPJK:'',CODE:id.replace('NAS-','NAS'),NAME:p.name,CATEGORY:p.category||'GENERAL',PHONE:p.phone||'',ID_TYPE:p.idType||'',ID_NUMBER:p.idNumber||'',STATUS:'ACTIVE',CREATED_AT:new Date(),UPDATED_AT:new Date()};MC_Database.insert('CUSTOMERS',x);MC_Database.audit('Nasabah','CREATE',id,null,x,'Create customer');return x}if(a==='createTransaction')return MC_Core.transaction(p,s);throw new Error('API tidak dikenal')}};