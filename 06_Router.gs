const MC_Router={render:function(e){return HtmlService.createTemplateFromFile('Index').evaluate().setTitle(MC_CONFIG.APP_NAME).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)},api:function(a,p){p=p||{};if(a==='login')return MC_Auth.login(p);if(a==='publicRates')return MC_Database.rows('RATE_MASTER').filter(function(x){return x.STATUS==='ACTIVE'});var s=MC_Auth.session(p.token);MC_Utils.require(s,'Session tidak valid');if(a==='logout')return MC_Auth.logout(p.token);if(a==='dashboard')return{purchase:0,sale:0,cash:0,bank:MC_Database.rows('BANK_ACCOUNTS').reduce(function(n,x){return n+Number(x.CURRENT_BALANCE||0)},0)};if(a==='moduleSchema')return MC_ModuleService.schema(p.module);if(a==='moduleList')return MC_ModuleService.list(p.module,p.query||{});if(a==='moduleGet')return MC_ModuleService.get(p.module,p.id);if(a==='moduleCreate')return MC_ModuleService.create(p.module,p.record||{});if(a==='moduleUpdate')return MC_ModuleService.update(p.module,p.id,p.record||{});if(a==='moduleDelete')return MC_ModuleService.remove(p.module,p.id,p.reason);if(a==='moduleAction')return MC_ModuleService.action(p.module,p.action,p.id,p.data);if(a==='currencies')return MC_Database.rows('CURRENCY_MASTER');if(a==='customers')return MC_Database.rows('CUSTOMERS');if(a==='transactions')return MC_Database.rows('TRANSACTIONS');if(a==='saveCustomer'){var id=MC_Utils.nextId('NAS');var x={ID:id,IDPJK:'',CODE:id.replace('NAS-','NAS'),NAME:p.name,CATEGORY:p.category||'GENERAL',PHONE:p.phone||'',ID_TYPE:p.idType||'',ID_NUMBER:p.idNumber||'',STATUS:'ACTIVE',CREATED_AT:new Date(),UPDATED_AT:new Date()};MC_Database.insert('CUSTOMERS',x);MC_Database.audit('Nasabah','CREATE',id,null,x,'Create customer');return x}if(a==='createTransaction')return MC_Core.transaction(p,s);throw new Error('API tidak dikenal: '+a)}};