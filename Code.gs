const APP={NAME:'MC-Almara',VERSION:'8.0.0',TZ:'Asia/Jakarta',TTL:21600,ROLES:['Admin','Manager','Teller','Kasir','Finance','Auditor'],PERMS:['view','create','edit','delete','print','export','approve','closing','rate_management','transaction_edit','wa'],SHEETS:{CONFIG:['KEY','VALUE','DESCRIPTION'],USERS:['ID','USERNAME','EMAIL','PASSWORD_HASH','NAME','ROLE_ID','STATUS','CREATED_AT','UPDATED_AT'],ROLES:['ID','NAME','DESCRIPTION','STATUS'],PERMISSIONS:['ID','ROLE_ID','PERMISSION','MODULE','STATUS'],COMPANY_PROFILE:['ID','NAME','BRAND','LOGO','ADDRESS','PHONE','WHATSAPP','EMAIL','WEBSITE','NPWP','NIB','BI_LICENSE','IDPJK','GOAML_ID','OPERATING_HOURS','INVOICE_FOOTER','UPDATED_AT'],CUSTOMERS:['ID','IDPJK','CODE','NAME','CATEGORY','PHONE','ID_TYPE','ID_NUMBER','STATUS','CREATED_AT','UPDATED_AT'],DTOTT:['ID','NAME','ID_TYPE','ID_NUMBER','REASON','START_DATE','STATUS','NOTES','CREATED_AT'],TRANSACTIONS:['ID','INVOICE_NO','CUSTOMER_ID','BRANCH_ID','TELLER_ID','DATE','SIDE','CURRENCY','FOREIGN_AMOUNT','RATE','IDR_TOTAL','PURPOSE','FUND_SOURCE','STATUS','CREATED_AT','UPDATED_AT'],TRANSACTION_PAYMENTS:['ID','TRANSACTION_ID','METHOD','AMOUNT','BANK_ACCOUNT_ID','REFERENCE'],CASH_MUTATIONS:['ID','DATE','REF_TYPE','REF_ID','DIRECTION','AMOUNT','DESCRIPTION','BALANCE_AFTER','USER_ID','CREATED_AT'],BANK_ACCOUNTS:['ID','BANK','ACCOUNT_NO','OWNER','OPENING_BALANCE','CURRENT_BALANCE','STATUS'],BANK_MUTATIONS:['ID','DATE','BANK_ACCOUNT_ID','REF_TYPE','REF_ID','DIRECTION','AMOUNT','BALANCE_AFTER','DESCRIPTION','USER_ID','CREATED_AT'],FX_STOCK:['ID','CURRENCY','DENOMINATION','TYPE','QUANTITY','AVERAGE_RATE','STATUS'],FX_STOCK_MUTATIONS:['ID','DATE','REF_TYPE','REF_ID','CURRENCY','DENOMINATION','TYPE','QTY_DELTA','RATE','USER_ID','CREATED_AT'],CURRENCY_MASTER:['ID','ISO_CODE','NAME','COUNTRY','FLAG','SYMBOL','DECIMAL_PRECISION','STATUS','DISPLAY_ORDER'],RATE_MASTER:['ID','CURRENCY','BUY_REFERENCE','BUY_SPREAD','BUY_RATE','SELL_REFERENCE','SELL_SPREAD','SELL_RATE','SOURCE_URL','TIMESTAMP','STATUS'],EXPENSES:['ID','DATE','CATEGORY','AMOUNT','SOURCE','BANK_ACCOUNT_ID','DESCRIPTION','USER_ID','CREATED_AT'],GANTUNGAN:['ID','DATE','AMOUNT','DESCRIPTION','STATUS','CREATED_AT'],CLOSING:['ID','DATE','BRANCH_ID','SYSTEM_BALANCE','PHYSICAL_CASH','GANTUNGAN_OUTSTANDING','DIFFERENCE','STATUS','APPROVED_BY','CREATED_AT'],AUDIT_LOG:['ID','USER_ID','TIMESTAMP','MODULE','ACTION','RECORD_ID','OLD_VALUE','NEW_VALUE','REASON','SESSION_ID'],REPORT_EXPORT_LOG:['ID','USER_ID','REPORT','FORMAT','FILTER_JSON','STATUS','CREATED_AT'],SYSTEM_LOG:['ID','LEVEL','MODULE','MESSAGE','STACK','USER_ID','CREATED_AT']}};
function now_(){return new Date()}function uuid_(){return Utilities.getUuid()}function sha_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(x=>('0'+(x&255).toString(16)).slice(-2)).join('')}function id_(p){return p+'-'+uuid_().slice(0,8).toUpperCase()}function req_(x,m){if(!x)throw new Error(m)}function num_(x){const n=Number(x);req_(isFinite(n),'Nominal tidak valid');return n}function json_(x){return JSON.stringify(x==null?null:x)}
function setupSystem(){let id=PropertiesService.getScriptProperties().getProperty('DB_SPREADSHEET_ID'),ss=null;if(id)try{ss=SpreadsheetApp.openById(id)}catch(e){}if(!ss){ss=SpreadsheetApp.create(APP.NAME+' DB');PropertiesService.getScriptProperties().setProperty('DB_SPREADSHEET_ID',ss.getId())}Object.keys(APP.SHEETS).forEach(n=>{let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);const h=APP.SHEETS[n];if(s.getLastRow()===0)s.getRange(1,1,1,h.length).setValues([h])});seed_();return{ok:true,spreadsheetId:ss.getId(),url:ss.getUrl(),sheetCount:Object.keys(APP.SHEETS).length}}
function db_(){return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('DB_SPREADSHEET_ID'))}function sh_(n){const s=db_().getSheetByName(n);req_(s,'Sheet '+n+' tidak ada');return s}function rows_(n){const s=sh_(n),v=s.getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>Object.fromEntries(v[0].map((k,i)=>[k,r[i]])))}function add_(n,o){const s=sh_(n),h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(k=>o[k]??''));return o}function find_(n,k,v){return rows_(n).find(x=>String(x[k])===String(v))||null}function update_(n,k,v,p){const s=sh_(n),d=s.getDataRange().getValues(),h=d[0],ki=h.indexOf(k);for(let i=1;i<d.length;i++)if(String(d[i][ki])===String(v)){Object.keys(p).forEach(x=>{const c=h.indexOf(x);if(c>=0)d[i][c]=p[x]});s.getRange(i+1,1,1,h.length).setValues([d[i]]);return}throw new Error('Record tidak ditemukan')}
function audit_(m,a,r,o,n,reason){add_('AUDIT_LOG',{ID:uuid_(),USER_ID:Session.getActiveUser().getEmail()||'system',TIMESTAMP:now_(),MODULE:m,ACTION:a,RECORD_ID:r,OLD_VALUE:json_(o),NEW_VALUE:json_(n),REASON:reason||'',SESSION_ID:Session.getTemporaryActiveUserKey()})}
function seed_(){if(!rows_('ROLES').length)APP.ROLES.forEach((x,i)=>add_('ROLES',{ID:'ROLE-'+(i+1),NAME:x,DESCRIPTION:'Default role',STATUS:'ACTIVE'}));if(!rows_('PERMISSIONS').length)rows_('ROLES').forEach(r=>APP.PERMS.forEach(p=>add_('PERMISSIONS',{ID:uuid_(),ROLE_ID:r.ID,PERMISSION:p,MODULE:'*',STATUS:'ACTIVE'})));if(!rows_('CURRENCY_MASTER').length)[['IDR','Indonesian Rupiah',0],['USD','US Dollar',2],['EUR','Euro',2],['JPY','Japanese Yen',0],['KWD','Kuwaiti Dinar',3],['BHD','Bahraini Dinar',3]].forEach((x,i)=>add_('CURRENCY_MASTER',{ID:'CUR-'+(i+1),ISO_CODE:x[0],NAME:x[1],COUNTRY:'',FLAG:'',SYMBOL:'',DECIMAL_PRECISION:x[2],STATUS:'ACTIVE',DISPLAY_ORDER:i+1}))}
function createInitialAdmin(){setupSystem();if(rows_('USERS').some(x=>x.ROLE_ID==='ROLE-1'))return{message:'Admin sudah ada'};const p='Admin-'+uuid_().slice(0,8);add_('USERS',{ID:id_('USR'),USERNAME:'admin',EMAIL:'',PASSWORD_HASH:sha_(p),NAME:'Administrator',ROLE_ID:'ROLE-1',STATUS:'ACTIVE',CREATED_AT:now_(),UPDATED_AT:now_()});return{username:'admin',password:p}}
function login_(p){const u=rows_('USERS').find(x=>x.USERNAME===p.username||x.EMAIL===p.username);req_(u&&u.STATUS==='ACTIVE','Username tidak ditemukan');req_(u.PASSWORD_HASH===sha_(p.password),'Password salah');const t=uuid_();CacheService.getScriptCache().put('SESS_'+t,json_({id:u.ID,name:u.NAME,roleId:u.ROLE_ID,email:u.EMAIL}),APP.TTL);audit_('AUTH','LOGIN',u.ID,null,{username:u.USERNAME});return{token:t,user:{id:u.ID,name:u.NAME,roleId:u.ROLE_ID,email:u.EMAIL}}}function sess_(t,p){const s=JSON.parse(CacheService.getScriptCache().get('SESS_'+t)||'null');req_(s,'Session tidak valid');if(p)req_(rows_('PERMISSIONS').some(x=>x.ROLE_ID===s.roleId&&x.PERMISSION===p&&x.STATUS==='ACTIVE'),'Permission ditolak');return s}
function nextNo_(p){const l=LockService.getScriptLock();l.waitLock(30000);try{const k='SEQ_'+p+'_'+Utilities.formatDate(now_(),APP.TZ,'yyyyMMdd'),pr=PropertiesService.getScriptProperties(),n=Number(pr.getProperty(k)||0)+1;pr.setProperty(k,n);return p+'-'+Utilities.formatDate(now_(),APP.TZ,'yyyyMMdd')+'-'+('000000'+n).slice(-6)}finally{l.releaseLock()}}
function cash_(){return rows_('CASH_MUTATIONS').reduce((a,r)=>a+(r.DIRECTION==='IN'?Number(r.AMOUNT):-Number(r.AMOUNT)),0)}function createTx_(p){const u=sess_(p.token,'create');req_(p.customerId,'Nasabah wajib');req_(['BUY','SELL'].includes(p.side),'Side invalid');const a=num_(p.foreignAmount),rate=num_(p.rate),total=Math.round(a*rate);const cur=find_('CURRENCY_MASTER','ISO_CODE',p.currency);req_(cur&&cur.STATUS==='ACTIVE','Currency tidak aktif');const id=nextNo_('TRX'),inv=nextNo_('INV'),t={ID:id,INVOICE_NO:inv,CUSTOMER_ID:p.customerId,BRANCH_ID:p.branchId||'MAIN',TELLER_ID:u.id,DATE:now_(),SIDE:p.side,CURRENCY:p.currency,FOREIGN_AMOUNT:a,RATE:rate,IDR_TOTAL:total,PURPOSE:p.purpose||'',FUND_SOURCE:p.fundSource||'',STATUS:'POSTED',CREATED_AT:now_(),UPDATED_AT:now_()};add_('TRANSACTIONS',t);const ps=p.payments||[],sum=ps.reduce((z,x)=>z+num_(x.amount),0);req_(Math.abs(sum-total)<.01,'Payment harus sama dengan total');ps.forEach(x=>add_('TRANSACTION_PAYMENTS',{ID:uuid_(),TRANSACTION_ID:id,METHOD:x.method,AMOUNT:num_(x.amount),BANK_ACCOUNT_ID:x.bankAccountId||'',REFERENCE:x.reference||''}));const cash=ps.filter(x=>x.method==='CASH').reduce((z,x)=>z+num_(x.amount),0);if(cash)add_('CASH_MUTATIONS',{ID:uuid_(),DATE:now_(),REF_TYPE:'TRANSACTION',REF_ID:id,DIRECTION:p.side==='BUY'?'IN':'OUT',AMOUNT:cash,DESCRIPTION:inv,BALANCE_AFTER:cash_()+(p.side==='BUY'?cash:-cash),USER_ID:u.id,CREATED_AT:now_()});let st=rows_('FX_STOCK').find(x=>x.CURRENCY===p.currency&&String(x.DENOMINATION)===String(p.denomination||''));const q=p.side==='BUY'?a:-a;if(st)update_('FX_STOCK','ID',st.ID,{QUANTITY:Number(st.QUANTITY||0)+q});else add_('FX_STOCK',{ID:uuid_(),CURRENCY:p.currency,DENOMINATION:p.denomination||'',TYPE:'BANKNOTE',QUANTITY:q,AVERAGE_RATE:rate,STATUS:'ACTIVE'});add_('FX_STOCK_MUTATIONS',{ID:uuid_(),DATE:now_(),REF_TYPE:'TRANSACTION',REF_ID:id,CURRENCY:p.currency,DENOMINATION:p.denomination||'',TYPE:'BANKNOTE',QTY_DELTA:q,RATE:rate,USER_ID:u.id,CREATED_AT:now_()});audit_('TRANSACTIONS','CREATE',id,null,t);return{transaction:t,invoice:inv}}
function dashboard_(){return{cash:cash_(),bank:rows_('BANK_ACCOUNTS').reduce((a,r)=>a+Number(r.CURRENT_BALANCE||r.OPENING_BALANCE||0),0),purchase:rows_('TRANSACTIONS').filter(r=>r.SIDE==='BUY').reduce((a,r)=>a+Number(r.IDR_TOTAL||0),0),sale:rows_('TRANSACTIONS').filter(r=>r.SIDE==='SELL').reduce((a,r)=>a+Number(r.IDR_TOTAL||0),0),expenses:rows_('EXPENSES').reduce((a,r)=>a+Number(r.AMOUNT||0),0),stock:rows_('FX_STOCK').reduce((a,r)=>a+Number(r.QUANTITY||0),0)}}
function api_(action,p){switch(action){case'login':return login_(p);case'dashboard':return dashboard_();case'customers':return rows_('CUSTOMERS').slice(0,200);case'saveCustomer':const x={ID:p.id||id_('NAS'),IDPJK:p.idpjk||'',CODE:p.code||nextNo_('NAS'),NAME:p.name,CATEGORY:p.category||'Perorangan',PHONE:p.phone||'',ID_TYPE:p.idType||'',ID_NUMBER:p.idNumber||'',STATUS:'ACTIVE',CREATED_AT:now_(),UPDATED_AT:now_()};add_('CUSTOMERS',x);audit_('CUSTOMERS','CREATE',x.ID,null,x);return x;case'currencies':return rows_('CURRENCY_MASTER');case'transactions':return rows_('TRANSACTIONS').slice(-300).reverse();case'createTransaction':return createTx_(p);case'rates':return rows_('RATE_MASTER');case'publicRates':return rows_('RATE_MASTER').filter(x=>x.STATUS==='ACTIVE');default:throw new Error('Unknown action')}}
function doGet(e){const t=HtmlService.createTemplateFromFile('Index');return t.evaluate().setTitle(APP.NAME+' '+APP.VERSION).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}